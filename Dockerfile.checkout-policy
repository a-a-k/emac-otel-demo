FROM golang:1.25.7-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY third_party/opentelemetry-demo/src/checkout/go.mod third_party/opentelemetry-demo/src/checkout/go.sum ./third_party/opentelemetry-demo/src/checkout/
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY third_party/opentelemetry-demo/src/checkout/genproto ./third_party/opentelemetry-demo/src/checkout/genproto
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/checkout-policy ./cmd/checkout-policy

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/checkout-policy /checkout-policy
ENTRYPOINT ["/checkout-policy"]
